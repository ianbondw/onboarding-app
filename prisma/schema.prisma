// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Identity & contact
  firstName          String
  lastName           String
  email              String            // ⬅️ removed @unique (was global)
  phone              String?
  dateOfBirth        DateTime?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?  @default("US")
  citizenship        String?  @default("US")

  // Sensitive (encrypted)
  // LEGACY (kept for safety; not used going forward)
  ssnCipher          Bytes?
  ssnIv              Bytes?

  // NEW packed AES-GCM fields: iv(12) | ciphertext | tag(16)
  ssnEnc             Bytes?
  dobEnc             Bytes?

  // Employment & income
  employmentStatus   String?   // employed | self_employed | student | retired | unemployed
  employerName       String?
  annualIncomeBand   String?   // <50k | 50-100k | 100-250k | 250-500k | 500k+
  sourceOfFunds      String?   // salary | business | inheritance | asset_sale | other

  // Wealth snapshot
  liquidAssetsBand   String?
  illiquidAssetsBand String?
  liabilitiesBand    String?
  netWorthBand       String?

  // Suitability & preferences
  riskTolerance        String?   // conservative | moderate | growth | aggressive
  timeHorizon          String?   // <3y | 3-5y | 5-10y | 10+y
  primaryGoals         String[]  // [retirement, income, growth, education, legacy, tax]
  liquidityNeeds       String?   // none | some | high
  constraints          String[]  // [no_leverage, esg_only]
  investmentExperience String?   // none | basic | intermediate | advanced

  // Per-goal fine-tuning (risk/horizon/liquidity keyed by goal)
  goalsDetail        Json?

  // Narratives (optional, “warmer” free text)
  introNarrative     String?
  goalsNarrative     String?
  concernsNarrative  String?

  /// Server-computed onboarding progress (0-100)
  onboardingProgress Int       @default(0)
  /// Optional section-by-section completion snapshot
  sectionCompletion  Json?

  // Existing accounts (light)
  hasIRA             Boolean   @default(false)
  has401k            Boolean   @default(false)
  hasTaxable         Boolean   @default(true)
  hasCrypto          Boolean   @default(false)
  hasRealEstate      Boolean   @default(false)

  // KYC docs (store URLs/paths or provider refs)
  identityVerificationStatus String @default("pending") // pending | in_review | verified | failed
  documentVerificationStatus String @default("pending") // pending | in_review | verified | failed
  idDocType          String?   // driver_license | passport | other
  idDocUrl           String?
  idDocProviderRef   String?
  proofOfAddressUrl  String?
  reviewNotes        String?
  reviewedAt         DateTime?
  reviewedBy         String?

  // Consent & status
  consentAcceptedAt  DateTime?
  onboardingStatus   String    @default("in_progress") // in_progress | verified | declined
  retentionStatus    String    @default("active") // active | legal_hold | deletion_pending | redacted
  deletedAt          DateTime?

  // Advisor tracking
  advisorId          String?   // keep optional to avoid migration pain on old rows
  advisor            Advisor?  @relation(fields: [advisorId], references: [id])
  advisorName        String?
  advisorFirm        String?

  // Intake link token
  intakeToken        String?   @unique

  // Full submission snapshot for audit/analytics
  rawSubmission      Json?

  matches            ProductMatch[]
  lifecycleEvents    LifecycleEvent[]

  // 🔁 Opposite side of ClientFieldFlag.client
  clientFieldFlags   ClientFieldFlag[]

  @@index([createdAt])
  @@index([advisorId])
  @@index([retentionStatus, deletedAt])
  @@unique([advisorId, email]) // ⬅️ unique per advisor
}

model ProductMatch {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String

  productCode String
  productName String
  rationale   String
  riskBand    String?
}

model Advisor {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slug        String       @unique
  name        String
  email       String?
  firm        String?
  clients     Client[]
  intakeLinks IntakeLink[]
  users       PortalUser[]
  sessions    PortalSession[]
  trialLeads  TrialLead[]
  privacyRequests PrivacyRequest[]
  lifecycleEvents LifecycleEvent[]
  auditLogs   AuditLog[]
  loginChallenges PortalLoginChallenge[]
}

model IntakeLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique

  advisor   Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId String

  expiresAt DateTime?
  isActive  Boolean  @default(true)
}

model PortalUser {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  email        String          @unique
  passwordHash String?
  role         String          // owner | advisor | ops
  isActive     Boolean         @default(true)
  mfaEnabled   Boolean         @default(true)
  mfaMethod    String?         @default("email_otp")
  lastLoginAt  DateTime?
  advisorId    String?
  advisor      Advisor?        @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  sessions     PortalSession[]
  auditLogs    AuditLog[]
  loginChallenges PortalLoginChallenge[]

  @@index([advisorId, role])
}

model PortalSession {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tokenHash  String      @unique
  role       String      // owner | advisor
  label      String?
  expiresAt  DateTime
  lastSeenAt DateTime    @default(now())
  userId     String?
  user       PortalUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisorId  String?
  advisor    Advisor?    @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([advisorId, role])
  @@index([userId, expiresAt])
}

model TrialLead {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  name           String
  email          String
  firm           String?
  source         String           @default("website")
  status         String           @default("new") // new | activated | archived
  retentionStatus String          @default("active") // active | legal_hold | deletion_pending | redacted
  deletedAt      DateTime?
  onboardingUrl  String?
  adminUrl       String?
  metadata       Json?
  advisorId      String?
  advisor        Advisor?         @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  lifecycleEvents LifecycleEvent[]

  @@index([email, createdAt])
  @@index([advisorId, status])
  @@index([retentionStatus, deletedAt])
}

model PortalLoginChallenge {
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tokenHash      String      @unique
  codeHash       String
  purpose        String      @default("login")
  email          String
  role           String
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int         @default(0)
  ipHash         String?
  userAgent      String?
  userId         String?
  user           PortalUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisorId      String?
  advisor        Advisor?    @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@index([userId, expiresAt])
  @@index([advisorId, expiresAt])
}

model PrivacyRequest {
  id                String      @id @default(cuid())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  requestType       String      // access | deletion | correction | retention_review | legal_hold
  status            String      @default("received") // received | awaiting_identity | in_review | approved | completed | rejected | on_hold
  source            String      @default("website") // website | internal | customer_success
  subjectType       String      @default("individual") // individual | client | lead | advisor_user | firm
  email             String
  name              String
  firm              String?
  relationship      String?
  advisorId         String?
  advisor           Advisor?    @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  dueAt             DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  completedAt       DateTime?
  legalHold         Boolean     @default(false)
  identityVerifiedAt DateTime?
  details           String?
  resolutionSummary String?
  metadata          Json?

  @@index([email, status])
  @@index([requestType, status])
  @@index([advisorId, createdAt])
}

model LifecycleEvent {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  eventType  String
  actorRole  String?
  metadata   Json?
  advisorId  String?
  advisor    Advisor?   @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       TrialLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([advisorId, createdAt])
  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  actorRole   String
  actorLabel  String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  actorUserId String?
  actorUser   PortalUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  advisorId   String?
  advisor     Advisor?    @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  @@index([advisorId, createdAt])
  @@index([targetType, targetId])
}

model ClientFieldFlag {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  advisorId  String

  fieldKey   String   // e.g., "employmentStatus", "annualIncomeBand", "constraints"
  note       String?  // optional free text from client ("not sure which band", etc.)
  status     String   @default("open") // open | resolved

  @@index([advisorId, clientId, fieldKey, status])
}
